{
  "$schema": "http://json.schemastore.org/template",
  "author": "YuChia-Wei",
  "classifications": [
    "ArchPrecept",
    "Architecture"
  ],
  "identity": "ArchPrecept.Templates.Handler",
  "name": "ArchPrecept host-neutral dispatch handler",
  "shortName": "ap-handler",
  "description": "Host-neutral dispatch handler.",
  "tags": {
    "language": "C#",
    "type": "item"
  },
  "sourceName": "ActionName",
  "preferNameDirectory": false,
  "symbols": {
    "namespace": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": true,
      "description": "Existing C# namespace.",
      "replaces": "ItemNamespace"
    },
    "application": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": true,
      "description": "Namespace containing I<Name>UseCase, <Name>Input(string Value) and <Name>Output with a string Value.",
      "replaces": "ApplicationNamespace"
    }
  }
}
