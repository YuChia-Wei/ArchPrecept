{
  "$schema": "http://json.schemastore.org/template",
  "author": "YuChia-Wei",
  "classifications": [
    "ArchPrecept",
    "Architecture"
  ],
  "identity": "ArchPrecept.Templates.ScalarValueObject",
  "name": "ArchPrecept scalar value object",
  "shortName": "ap-vo",
  "description": "Add a value object with value equality and an immutable scalar property.",
  "tags": {
    "language": "C#",
    "type": "item"
  },
  "sourceName": "ScalarValue",
  "preferNameDirectory": false,
  "symbols": {
    "contracts": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "reference",
      "choices": [
        {
          "choice": "reference",
          "description": "Use ArchPrecept.Contracts.Domain.IValueObject."
        },
        {
          "choice": "custom",
          "description": "Use a consumer-owned value object marker."
        }
      ],
      "description": "Value object contract used by the target project."
    },
    "CustomContracts": {
      "type": "computed",
      "value": "(contracts == \"custom\")"
    },
    "namespace": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": true,
      "description": "Existing C# namespace where the value object belongs.",
      "replaces": "ItemNamespace"
    },
    "marker": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "IDomainValue",
      "description": "Marker interface for custom mode. Use a qualified C# name for a marker in another namespace.",
      "replaces": "CustomValueMarker"
    },
    "scalar": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "decimal",
      "choices": [
        {
          "choice": "decimal"
        },
        {
          "choice": "int"
        },
        {
          "choice": "long"
        }
      ],
      "description": "Scalar type held by the value object.",
      "replaces": "ScalarType"
    }
  }
}
