<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageType>Template</PackageType>
    <PackageTags>dotnet-new;templates;csharp;architecture</PackageTags>
    <Description>ArchPrecept starter, domain and application items, delivery adapters, architecture tests, and use-case method snippets for the .NET SDK.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackStarterProject</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <ItemGroup>
    <None Include="content/**/*" Exclude="**/bin/**;**/obj/**;content/starter/SampleShop.csproj" Pack="true"
          PackagePath="content/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="PackStarterProject">
    <PropertyGroup>
      <StarterProject>$(IntermediateOutputPath)SampleShop.csproj</StarterProject>
    </PropertyGroup>
    <Copy SourceFiles="content/starter/SampleShop.csproj" DestinationFiles="$(StarterProject)" />
    <XmlPoke XmlInputPath="$(StarterProject)" Query="/Project/ItemGroup/PackageReference[starts-with(@Include, 'ArchPrecept.')]/@Version"
             Value="[$(PackageVersion)]" />
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(StarterProject)" PackagePath="content/starter/SampleShop.csproj" />
    </ItemGroup>
  </Target>
</Project>
