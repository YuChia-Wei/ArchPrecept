<Project>
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- ArchPrecept is approved; packaging remains disabled until package identities and the release contract are approved. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
