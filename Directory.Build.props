<Project>
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <Version>0.0.3-preview</Version>
    <!-- Only explicitly opted-in product projects ship. -->
    <IsPackable>false</IsPackable>
    <Authors>YuChia-Wei</Authors>
    <RepositoryUrl>https://github.com/YuChia-Wei/ArchPrecept</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/YuChia-Wei/ArchPrecept</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>ArchPrecept reusable architecture contracts and Roslyn analyzers. Experimental preview.</Description>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Copyright>Copyright 2026 YuChia Wei</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="/" Condition="Exists('$(MSBuildThisFileDirectory)LICENSE')" />
    <None Include="$(MSBuildThisFileDirectory)NOTICE" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <!-- Ship the same authored sources, preserving relative links without a second rule catalog. -->
    <None Include="$(MSBuildThisFileDirectory)docs/**/*.md" Pack="true" PackagePath="docs/" />
    <None Include="$(MSBuildThisFileDirectory)rules/catalog.xml" Pack="true" PackagePath="rules/" Condition="'$(MSBuildProjectName)' != 'ArchPrecept.Analyzers.Core'" />
    <None Include="$(MSBuildThisFileDirectory)rules/configuration.xsd" Pack="true" PackagePath="rules/" />
    <None Include="$(MSBuildThisFileDirectory)rules/catalog.xsd" Pack="true" PackagePath="rules/" />
  </ItemGroup>
</Project>
